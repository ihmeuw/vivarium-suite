{
    "mcpServers": {
        "jira": {
            "command": "uv",
            "args": ["run", "--quiet", "--script", "${CLAUDE_PLUGIN_ROOT}/mcp-servers/jira/server.py"],
            "env": {
                "JIRA_API_TOKEN": "${user_config.jira_api_token}",
                "JIRA_PROJECT": "${user_config.jira_project}",
                "JIRA_BOARD_ID": "${user_config.jira_board_id}"
            }
        }
    }
}
